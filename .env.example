# Get API_ID/API_HASH from https://my.telegram.org
API_ID=123456
API_HASH=your_api_hash
BOT_TOKEN=123456:your_bot_token

# Generate using: python generate_session.py
USER_SESSION=your_mtproto_user_session_string

# Private Telegram channel ID, e.g. -1001234567890
# Add BOTH the user account and bot as channel admins.
STORAGE_CHAT_ID=-1001234567890

# Comma-separated Telegram numeric user IDs allowed to use admin stats
ADMIN_IDS=123456789

# Maximum total download size. Files are split into documents of PART_SIZE_MB.
MAX_FILE_SIZE_GB=20
PART_SIZE_MB=1900
MAX_CONCURRENT_JOBS=1
DOWNLOAD_TIMEOUT=90

# Dashboard
PORT=8080
DASHBOARD_HOST=0.0.0.0
DASHBOARD_TOKEN=replace_with_a_long_random_secret
DATABASE_PATH=data/bot.sqlite3
LOG_LEVEL=INFO
